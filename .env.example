# Copy this file to '.env' and set a strong password (8+ chars including uppercase, lowercase, digit and symbol)
SA_PASSWORD=Change_This_Str0ng_P@ssword!

# JWT signing key for the api service (Docker only — local `dotnet run` uses
# user-secrets instead). Must be 32+ characters.
JWT_KEY=Change_This_To_A_Long_Random_String_At_Least_32_Characters
